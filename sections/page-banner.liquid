<div class="page-banner text-align-{{ section.settings.text_align }}" style="
  background-color:{{ section.settings.bg_color | default: 'var(--color-secondary)' }};
  padding-top:{{ section.settings.padding_top }}px;
  padding-bottom:{{ section.settings.padding_bottom }}px;
  {% if section.settings.image != blank %}background-image:url('{{ section.settings.image | image_url: width: 1800 }}'); background-size:cover; background-position:center;{% endif %}
">
  <div class="container">
    {% render 'heading',
      text: section.settings.heading,
      tag: 'h1',
      size: section.settings.heading_size,
      align: section.settings.text_align,
      color: section.settings.heading_color,
      weight: 'bold',
      subtext: section.settings.subheading
    %}
  </div>
</div>

{% schema %}
{
  "name": "Page banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page title" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [
      { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "xlarge", "label": "Extra large" }
    ], "default": "xlarge" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Background color" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Page banner" }]
}
{% endschema %}
