<div class="section image-with-text" style="background:{{ section.settings.bg_color | default: 'transparent' }}; padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="container image-with-text__grid image-with-text__grid--{{ section.settings.layout }}">

    <div class="image-with-text__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- else -%}
        <div class="image-with-text__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    <div class="image-with-text__content text-align-{{ section.settings.text_align }}">
      {% render 'heading',
        text: section.settings.heading,
        tag: 'h2',
        size: section.settings.heading_size,
        align: section.settings.text_align,
        color: section.settings.heading_color,
        weight: 'bold'
      %}
      {%- if section.settings.body != blank -%}
        <div class="image-with-text__body" style="color:{{ section.settings.text_color | default: 'inherit' }}; font-size:{{ section.settings.body_size }}px;">
          {{ section.settings.body }}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--{{ section.settings.button_style }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "image-left", "label": "Image left" }, { "value": "image-right", "label": "Image right" }
    ], "default": "image-left" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our mission" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ], "default": "medium" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Describe this in more detail.</p>" },
    { "type": "range", "id": "body_size", "label": "Body font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "text_color", "label": "Body text color" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
      { "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }
    ], "default": "solid" },
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background color" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
