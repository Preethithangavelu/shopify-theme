<div class="section rich-text" style="
  background: {{ section.settings.bg_color | default: 'transparent' }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="container container--narrow">
    {% render 'heading',
      text: section.settings.heading,
      tag: 'h2',
      size: section.settings.heading_size,
      align: section.settings.text_align,
      color: section.settings.heading_color,
      weight: section.settings.heading_weight
    %}

    {%- if section.settings.body != blank -%}
      <div class="rich-text__body text-align-{{ section.settings.text_align }}" style="color:{{ section.settings.text_color | default: 'inherit' }}; font-size:{{ section.settings.body_size }}px;">
        {{ section.settings.body }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="text-align-{{ section.settings.text_align }}">
        <a href="{{ section.settings.button_link }}" class="button button--{{ section.settings.button_style }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "About our story" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "xlarge", "label": "Extra large" }
    ], "default": "large" },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [
      { "value": "normal", "label": "Normal" }, { "value": "bold", "label": "Bold" }
    ], "default": "bold" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Tell your brand story here.</p>" },
    { "type": "range", "id": "body_size", "label": "Body font size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "text_color", "label": "Body text color" },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ], "default": "center" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
      { "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }
    ], "default": "solid" },
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background color" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
