<div class="section main-search">
  <div class="container">
    <h1>Search results</h1>
    <form action="{{ routes.search_url }}" method="get" class="search-form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products">
      <button type="submit">Search</button>
    </form>
    {%- if search.performed -%}
      <div class="product-grid product-grid--4-col product-grid--mobile-2-col">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- else -%}
          <p>No results found for "{{ search.terms }}".</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}{ "name": "Search results", "settings": [] }{% endschema %}
