<div class="section main-collection" style="padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.show_heading -%}
      {% render 'heading', text: collection.title, tag: 'h1', size: 'large', align: section.settings.heading_align, weight: 'bold' %}
      {%- if collection.description != blank -%}
        <div class="collection__description text-align-{{ section.settings.heading_align }}">{{ collection.description }}</div>
      {%- endif -%}
    {%- endif -%}

    {% paginate collection.products by 12 %}
      <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col product-grid--mobile-{{ section.settings.columns_mobile }}-col">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p>No products found in this collection yet.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "checkbox", "id": "show_heading", "label": "Show collection title", "default": true },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
    ], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
    ], "default": "2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ]
}
{% endschema %}
