[
  {
    "name": "theme_info",
    "theme_name": "Custom Storefront",
    "theme_version": "1.0.0",
    "theme_author": "Custom Build",
    "theme_documentation_url": "https://shopify.dev/docs",
    "theme_support_url": "https://shopify.dev/docs"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Global palette" },
      { "type": "color", "id": "color_background", "label": "Background", "default": "#FFFFFF" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#1A1A1A" },
      { "type": "color", "id": "color_primary", "label": "Primary / accent", "default": "#1B4332" },
      { "type": "color", "id": "color_primary_text", "label": "Text on primary", "default": "#FFFFFF" },
      { "type": "color", "id": "color_secondary", "label": "Secondary surface", "default": "#F5F3EE" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#E4E1D9" },
      { "type": "color", "id": "color_header_bg", "label": "Header background", "default": "#FFFFFF" },
      { "type": "color", "id": "color_header_text", "label": "Header text", "default": "#1A1A1A" },
      { "type": "color", "id": "color_footer_bg", "label": "Footer background", "default": "#1B4332" },
      { "type": "color", "id": "color_footer_text", "label": "Footer text", "default": "#F5F3EE" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "header", "content": "Headings" },
      { "type": "font_picker", "id": "type_header_font", "label": "Heading font", "default": "work_sans_n7" },
      { "type": "range", "id": "type_header_scale", "label": "Heading size scale", "min": 90, "max": 150, "step": 5, "unit": "%", "default": 100 },
      { "type": "header", "content": "Body" },
      { "type": "font_picker", "id": "type_body_font", "label": "Body font", "default": "assistant_n4" },
      { "type": "range", "id": "type_body_scale", "label": "Body size scale", "min": 90, "max": 130, "step": 5, "unit": "%", "default": 100 }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Page width", "min": 1000, "max": 1600, "step": 40, "unit": "px", "default": 1280 },
      { "type": "range", "id": "spacing_sections", "label": "Space between sections", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
      { "type": "select", "id": "corner_radius", "label": "Corner roundness", "options": [
        { "value": "0px", "label": "None" },
        { "value": "6px", "label": "Small" },
        { "value": "14px", "label": "Medium" },
        { "value": "24px", "label": "Large" }
      ], "default": "14px" }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      { "type": "select", "id": "button_style", "label": "Style", "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ], "default": "solid" },
      { "type": "select", "id": "button_shape", "label": "Shape", "options": [
        { "value": "square", "label": "Square" },
        { "value": "rounded", "label": "Rounded" },
        { "value": "pill", "label": "Pill" }
      ], "default": "rounded" }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "select", "id": "card_image_ratio", "label": "Image ratio", "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ], "default": "square" },
      { "type": "checkbox", "id": "card_show_vendor", "label": "Show vendor", "default": false },
      { "type": "checkbox", "id": "card_show_badge", "label": "Show sale / sold-out badge", "default": true }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_x", "label": "X / Twitter URL" }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon image", "info": "Will be scaled down to 32 x 32px" }
    ]
  }
]
